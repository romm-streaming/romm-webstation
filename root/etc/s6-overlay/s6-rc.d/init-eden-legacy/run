#!/usr/bin/with-contenv bash

# EDEN_LEGACY=true swaps the bundled Eden, compiled for x86-64-v3 (AVX2), for
# upstream's legacy AppImage of the same version so pre-Haswell and pre-Ryzen
# CPUs can run it. The AppImage is kept extracted under /config, so it is
# downloaded once per Eden version rather than on every container start.

BUNDLED=/usr/bin/eden
SHADOWED=/usr/bin/eden.bundled
LEGACY_DIR=/config/.local/share/eden-legacy

if [[ "${EDEN_LEGACY,,}" != "true" ]]; then
  exit 0
fi

EDEN_VERSION=$(cat /usr/share/webstation/versions.d/eden)

if [[ "$(cat "${LEGACY_DIR}/version" 2>/dev/null)" != "${EDEN_VERSION}" ]]; then
  echo "[eden-legacy] fetching legacy Eden ${EDEN_VERSION}"
  if [[ ! -d /config/.local/share ]]; then
    mkdir -p /config/.local/share
    lsiown -R abc:abc /config/.local
  fi
  # staged next to LEGACY_DIR so the final mv is a rename on the same filesystem
  STAGE=$(mktemp -d /config/.local/share/.eden-legacy.XXXXXX)
  if URL=$(curl -fsSL --max-time 30 \
        "https://git.eden-emu.dev/api/v1/repos/eden-emu/eden/releases/tags/${EDEN_VERSION}" \
        | jq -er '.assets[] | select(.name | endswith("-legacy-clang-pgo.AppImage")) | .browser_download_url') && \
     curl -fsSL --retry 3 --max-time 600 -o "${STAGE}/eden.AppImage" "${URL}" && \
     chmod +x "${STAGE}/eden.AppImage" && \
     (cd "${STAGE}" && ./eden.AppImage --appimage-extract >/dev/null); then
    rm -rf "${LEGACY_DIR}"
    mkdir -p "${LEGACY_DIR}"
    # newer runtimes extract to AppDir with squashfs-root as a symlink to it
    mv "$(readlink -f "${STAGE}/squashfs-root")" "${LEGACY_DIR}/app"
    echo "${EDEN_VERSION}" > "${LEGACY_DIR}/version"
    lsiown -R abc:abc "${LEGACY_DIR}"
    echo "[eden-legacy] installed legacy Eden ${EDEN_VERSION}"
  else
    echo "[eden-legacy] WARNING: could not fetch legacy Eden ${EDEN_VERSION}"
  fi
  rm -rf "${STAGE}"
fi

# an older legacy build still beats the bundled one, which will not start on these CPUs
if [[ ! -x "${LEGACY_DIR}/app/AppRun" ]]; then
  echo "[eden-legacy] WARNING: no legacy Eden available, keeping the bundled build"
  exit 0
fi
if [[ "$(cat "${LEGACY_DIR}/version")" != "${EDEN_VERSION}" ]]; then
  echo "[eden-legacy] WARNING: using legacy Eden $(cat "${LEGACY_DIR}/version"), bundled is ${EDEN_VERSION}"
fi
# kept aside rather than deleted so a restart of this container finds it again
if [[ ! -f "${SHADOWED}" ]]; then
  mv "${BUNDLED}" "${SHADOWED}"
fi
# a wrapper, not a symlink: AppRun locates its bundle from its own path
printf '#!/bin/sh\nexec %s "$@"\n' "${LEGACY_DIR}/app/AppRun" > "${BUNDLED}"
chmod 755 "${BUNDLED}"
echo "[eden-legacy] ${BUNDLED} now runs the legacy build"
