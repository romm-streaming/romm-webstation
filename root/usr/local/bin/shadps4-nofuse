#!/usr/bin/env bash

# AppImages need FUSE and the container has none, so unpack each new build once
# and swap the bare binary in under the AppImage name the launcher and broker run.

VERSIONS_DIR="${HOME}/.local/share/shadPS4QtLauncher/versions"
TARGET_APPIMAGE="Shadps4-sdl.AppImage"
INTERNAL_BIN_PATH="usr/bin/shadps4"
MARKER_FILE=".nofuse_ready"
SLEEP_TIME="${1:-5}"

shopt -s nullglob
while true; do
  for folder in "$VERSIONS_DIR"/*; do
    [[ -d "$folder" && ! -f "$folder/$MARKER_FILE" && -f "$folder/$TARGET_APPIMAGE" ]] || continue
    (
      cd "$folder" || exit
      # Restarting this service orphans an extraction in flight; keep the next
      # instance out of squashfs-root until it lands.
      exec 9<.
      flock -n 9 || exit
      [[ -f "$MARKER_FILE" ]] && exit
      # Only a type 2 AppImage has "AI\2" at byte 8. Never run anything else: the
      # bare binary takes --appimage-extract as a game path and boots shadPS4.
      cmp -s -i 8:0 -n 3 "$TARGET_APPIMAGE" <(printf 'AI\002') || exit
      chmod +x "$TARGET_APPIMAGE"
      ./"$TARGET_APPIMAGE" --appimage-extract >/dev/null 2>&1
      # One rename, then the marker: a stop landing between them leaves the bare
      # binary unmarked, and it gets run with --appimage-extract every pass.
      if [[ -f "squashfs-root/$INTERNAL_BIN_PATH" ]] &&
        mv -f "squashfs-root/$INTERNAL_BIN_PATH" "$TARGET_APPIMAGE"; then
        : >"$MARKER_FILE"
      fi
      rm -rf squashfs-root
    )
  done
  sleep "$SLEEP_TIME"
done
